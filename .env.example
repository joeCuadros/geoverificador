# Copy to .env.local (local) or set these in the Vercel project (Settings > Environment Variables). Never commit real values.

# Google Gemini API key (https://aistudio.google.com/apikey). Server side only: the browser never sees it.
# Without it the assistant keeps working with its rule-based parser ("Modo: reglas").
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash-lite.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional local port.
# PORT=3000
