{
  "name": "geoverificador",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --filter @geoverificador/web build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "pnpm --filter @geoverificador/web start",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "datos:extraer": "node scripts/extraer-equipamiento.mjs && node packages/datos/src/cli.ts cargar equipamiento --si-hay-base",
    "datos:avisos": "node scripts/recolectar-avisos.mjs",
    "datos:smartbus": "node scripts/recolectar-smartbus.mjs",
    "datos:oficial": "node scripts/descargar-equipamiento-oficial.mjs && node packages/datos/src/cli.ts cargar equipamiento --si-hay-base",
    "datos:comercio": "node scripts/descargar-comercio.mjs && node packages/datos/src/cli.ts cargar equipamiento --si-hay-base",
    "datos:servicios": "node scripts/descargar-servicios-osm.mjs && node packages/datos/src/cli.ts cargar equipamiento --si-hay-base",
    "datos:acopio": "node scripts/convertir-acopio-sedapar.mjs && node packages/datos/src/cli.ts cargar agua/ --si-hay-base",
    "datos:interrupciones": "node scripts/descargar-interrupciones-sunass.mjs && node packages/datos/src/cli.ts cargar agua/ --si-hay-base",
    "datos:electricidad": "node scripts/descargar-concesiones-electricas.mjs && node packages/datos/src/cli.ts cargar electricidad --si-hay-base",
    "datos:censo": "node scripts/descargar-censo-servicios.mjs && node packages/datos/src/cli.ts cargar censo/ --si-hay-base",
    "datos:rutas-osm": "node scripts/descargar-rutas-osm.mjs && node packages/datos/src/cli.ts cargar rutas_osm --si-hay-base",
    "datos:sit": "node scripts/extraer-registro-sit.mjs && node packages/datos/src/cli.ts cargar sit_registro --si-hay-base",
    "datos:mineria": "node --use-system-ca scripts/descargar-concesiones-mineras.mjs && node packages/datos/src/cli.ts cargar mineria --si-hay-base",
    "datos:universidades": "node scripts/descargar-educacion-superior.mjs && node packages/datos/src/cli.ts cargar educacion_superior --si-hay-base",
    "datos:verificar": "node scripts/verificar-datos.mjs && node packages/datos/src/cli.ts verificar --si-hay-base",
    "datos:validar-osm": "node scripts/validar-zonificacion-osm.mjs",
    "datos:validar-oficial": "node scripts/validar-osm-oficial.mjs",
    "datos:validar-plano": "node scripts/validar-zonificacion-plano.mjs",
    "bd:migrar": "node packages/datos/src/cli.ts migrar",
    "bd:cargar": "node packages/datos/src/cli.ts cargar",
    "bd:verificar": "node packages/datos/src/cli.ts verificar",
    "bd:ficha": "node packages/datos/src/cli.ts ficha",
    "datos:tipo-cambio": "node packages/datos/src/cli.ts tipo-cambio",
    "avisos:ingerir": "node packages/datos/src/cli.ts avisos",
    "avisos:estado": "node packages/datos/src/cli.ts avisos-estado",
    "dominio:generar": "node scripts/generar-dominio.mjs && tsc -p packages/dominio/tsconfig.tipos.json",
    "dominio:verificar": "node scripts/generar-dominio.mjs --verificar",
    "test:nuevo": "vitest run",
    "test:dominio": "node ./node_modules/jest/bin/jest.js --config jest.dominio.config.ts",
    "lint": "oxlint --type-aware src/ test/ public/js/ api/ scripts/ web/app web/componentes web/lib packages/",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --inspect-brk --experimental-vm-modules -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "legado:build": "nest build",
    "legado:start": "nest start",
    "legado:start:dev": "nest start --watch",
    "dev": "pnpm --filter @geoverificador/web dev"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/observe": "^0.3.0",
    "@nestjs/platform-express": "^12.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "jest": "^30.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.2",
    "vitest": "^5.1.0"
  }
}
