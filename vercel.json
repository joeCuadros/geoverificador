{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo \"Sitio estático: sin instalación\"",
  "buildCommand": "echo \"Sitio estático: sin build\"",
  "outputDirectory": "public",
  "cleanUrls": false,
  "functions": {
    "api/chat.js": {
      "maxDuration": 20,
      "includeFiles": "public/js/{asistente-llm,asistente,calculos}.js"
    },
    "api/auth/*.js": {
      "maxDuration": 15,
      "includeFiles": "api/_lib/auth.js"
    }
  }
}
